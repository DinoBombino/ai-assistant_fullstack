##############
# Server
##############

# Server port
PORT=5000

# Node environment: development | production
NODE_ENV=development

##############
# AI Providers
##############

# Fireworks API key
FIREWORKS_API_KEY=your_fireworks_api_key_here

# Fireworks model (пример)
FIREWORKS_MODEL=accounts/fireworks/models/qwen3-vl-235b-a22b-instruct

# OpenRouter API key
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenAI (если хочешь использовать как fallback)
OPENAI_API_KEY=your_openai_api_key_here

# AI Provider Configuration
# Основной провайдер: fireworks | openai | openrouter | fallback
AI_PROVIDER=fireworks

# Fallback-провайдер, если основной недоступен
FALLBACK_PROVIDER=openai

# Модели по умолчанию
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_MODEL=openai/gpt-4o-mini  # или другая модель

##############
# Token limits
##############

DEFAULT_MAX_TOKENS=512
MAX_ALLOWED_TOKENS=8000
MAX_CONTEXT_TOKENS=4000

##############
# Database
##############

# Пример для локального Postgres в Docker (см. docker-compose.yml)
# DATABASE_URL=postgres://postgres:postgres@localhost:5433/postgres
DATABASE_URL=postgresql://postgres:password@localhost:5433/ai_assistant

##############
# Auth (JWT)
##############

# Секрет для подписи JWT (обязательно заменить на свой в проде)
JWT_SECRET=your_jwt_secret_here

# Время жизни токена
JWT_EXPIRE=7d

##############
# Client
##############

# URL фронтенда
CLIENT_URL=http://localhost:3000

# SurrealDB
SURREAL_URL=http://localhost:8000/rpc
SURREAL_NS=ai_assistant
SURREAL_DB=main
SURREAL_USER=root
SURREAL_PASS=change-me

# Files ingestion
FILES_MAX_SIZE_MB=20
FILES_SHARED_MODE=false

FILE_CHUNK_SIZE=1000
FILE_CHUNK_OVERLAP=150
FILE_MAX_CHUNKS=200